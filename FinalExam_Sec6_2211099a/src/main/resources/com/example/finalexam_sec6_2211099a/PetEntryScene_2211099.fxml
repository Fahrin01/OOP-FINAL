<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalexam_sec6_2211099a.PetEntryScene_2211099Controller">
    <children>
        <!-- Switch Scene Button -->
        <Button layoutX="30.0" layoutY="390.0" mnemonicParsing="false" onAction="#petLoadSceneButtonChangeOnAction" prefHeight="68.0" prefWidth="540.0" text="Go to Next (Pet Load) Scene" textAlignment="CENTER" wrapText="true">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Button>

        <!-- Pet ID -->
        <Label layoutX="30.0" layoutY="25.0" text="Pet ID" />
        <TextField fx:id="petID" layoutX="180.0" layoutY="20.0" />

        <!-- Pet Name -->
        <Label layoutX="30.0" layoutY="65.0" text="Name" />
        <TextField fx:id="name" layoutX="180.0" layoutY="60.0" />

        <!-- Species -->
        <Label layoutX="30.0" layoutY="105.0" text="Species" />
        <ComboBox fx:id="species" layoutX="180.0" layoutY="100.0" prefHeight="25.0" prefWidth="160.0" />

        <!-- Date of Birth -->
        <Label layoutX="30.0" layoutY="145.0" text="Date of Birth" />
        <DatePicker fx:id="dateOfBirth" layoutX="180.0" layoutY="140.0" prefHeight="25.0" prefWidth="160.0" />

        <!-- Adoption Status -->
        <Label layoutX="30.0" layoutY="185.0" text="Adoption Status" />

        <!-- Add Button -->
        <Button layoutX="370.0" layoutY="25.0" mnemonicParsing="false" onAction="#addPetButtonOnAction" prefHeight="270.0" prefWidth="200.0" text="Add (append) a new Pet to &quot;Pets.bin&quot; file" textAlignment="CENTER" wrapText="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Line endX="420.0" layoutX="120.0" layoutY="370.0" startX="-100.0" strokeWidth="3.0" />
      <CheckBox fx:id="adoptionStatusCheckbox" layoutX="180.0" layoutY="185.0" mnemonicParsing="false" text="Adopted?" />
    </children>
</AnchorPane>
